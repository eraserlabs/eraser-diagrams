{
  "name": "@eraserlabs/diagram-templates",
  "version": "0.2.0",
  "description": "The Eraser stock template library as data: per-tag schemas, markup and CSS, the palette, the normalizers and the page setup, with no browser or Chromium code.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eraserlabs/eraser-diagrams.git",
    "directory": "packages/templates"
  },
  "homepage": "https://github.com/eraserlabs/eraser-diagrams",
  "bugs": "https://github.com/eraserlabs/eraser-diagrams/issues",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./normalizers": {
      "types": "./dist/normalizers.d.ts",
      "default": "./dist/normalizers.js"
    },
    "./svg-transforms": {
      "types": "./dist/svgTransforms.d.ts",
      "default": "./dist/svgTransforms.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check-generated": "node scripts/generate.mjs && git diff --exit-code -- src/generated",
    "build": "node scripts/generate.mjs && tsc -b && node ../../tools/strip-dist-comments.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@eraserlabs/layout": "workspace:*",
    "@eraserlabs/protocol": "workspace:*",
    "@eraserlabs/render": "workspace:*",
    "@eraserlabs/resolve": "workspace:*"
  }
}
